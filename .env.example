# Copy to .env and fill in. .env is gitignored.

# filelist: your username, and the passkey from your profile page (filelist.io/my.php).
# scripts/find-passkey.py also recovers it from .torrent files you already have.
FILELIST_USERNAME=
FILELIST_PASSKEY=
# Category ids: 4=Movies HD, 6=Movies 4K, 21=TV-Series HD, 27=TV-Series 4K,
# 20=Movies Blu-Ray, 16=Docs, 24=Anime.
FILELIST_CATEGORIES=4,6,21,27
# When to check for new uploads. The API allows 150 requests an hour, one per category per sweep.
FILELIST_SWEEP_CRON=17 * * * *
FILELIST_MIN_SEEDERS=1

# Stremio addons, asked by IMDb id, instead of or beside filelist. Each address as the
# addon's configure page gives it, separated by spaces. Empty means Torrentio.
ADDONS_ENABLED=false
ADDON_URLS=

# TMDB v3 API key (not the v4 token), free from https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_LANGUAGE=en-US
TMDB_IMAGE_BASE=https://image.tmdb.org/t/p

# qBittorrent's web API and login.
QBIT_URL=http://qbittorrent:8080
QBIT_USERNAME=admin
QBIT_PASSWORD=
# Where qBittorrent writes, as seen from inside the VibeStream container.
QBIT_DOWNLOAD_DIR=/data/downloads

# Library folders, as seen from inside the VibeStream container.
LIBRARY_MOVIES_DIR=/data/vibestream/library/Movies
LIBRARY_SHOWS_DIR=/data/vibestream/library/Shows

# Delete watched titles this many days after they were last played.
REAPER_GRACE_DAYS=7
# Never remove a torrent before it has seeded this long or reached this ratio.
# filelist enforces a seeding policy, so do not set these to zero.
REAPER_MIN_SEED_HOURS=48
REAPER_MIN_SEED_RATIO=1.0
# Start deleting the oldest watched titles when free space drops below this.
REAPER_MIN_FREE_GB=100
# Remove a source once it has seeded and its rendition, audio and subtitles are kept.
SOURCES_AUTO_REMOVE=true
# false: only log what would be deleted.
REAPER_ENABLED=true

# Subtitle languages, best first. OpenSubtitles (optional key) fills in what the file lacks.
SUBTITLE_LANGUAGES=en
# Whose age rating a title shows, first found wins (ISO country codes).
RATING_REGIONS=US,GB
OPENSUBTITLES_API_KEY=

# Releases larger than this are ranked below smaller ones.
QUALITY_MAX_GB=30

# Only used by the legacy /api/stream endpoints.
STREAM_MIN_BUFFER_RATIO=0.02
STREAM_MIN_BUFFER_BYTES=33554432
STREAM_WAIT_TIMEOUT_S=90

# Database path, log level and time zone.
VIBESTREAM_DB_PATH=/app/data/vibestream.db
VIBESTREAM_LOG_LEVEL=INFO
TZ=UTC
# The uid and gid the containers run as; they must own the files under /data.
PUID=1000
PGID=1000

# The public https address the apps try first, and the http LAN address they fall back to.
PUBLIC_URL=https://vibestream.example.com
LAN_URL=http://your-server-on-the-lan:8100
# The app id on iOS, Android and webOS. Changing it later makes it a different app.
APP_ID=com.example.vibestream
# The Apple developer team that signs the iOS app.
APPLE_TEAM_ID=
# iOS devices to install on, by identifier (xcrun devicectl list devices), separated by spaces.
IOS_DEVICES=""
# Rooted LG TVs (Homebrew Channel) to install the webOS launcher on, by address, separated by spaces.
TV_HOSTS=""
# SSH key for root on the TVs.
TV_SSH_KEY=
