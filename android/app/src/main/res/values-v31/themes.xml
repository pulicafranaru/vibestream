<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and later draw the app icon over the window while the app
         starts, a lone V before the spinner. The ground and nothing on it. -->
    <style name="Theme.VibeStream" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/ground</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
